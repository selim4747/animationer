{
  "name": "animationer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "description": "3D & 2D Sahne ve Kamera İstasyonları Stüdyosu (DioramaStudio)",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "electron:dev": "electron .",
    "build:win": "vite build && electron-builder --win portable",
    "cap:sync": "cap sync",
    "cap:build:android": "npm run build && cap sync android",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.monochrome.threejsstudio",
    "productName": "DioramaStudio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "DioramaStudio-Windows.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "8.4.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
